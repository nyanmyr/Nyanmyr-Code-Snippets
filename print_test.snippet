<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://microsoft.com">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>print_test</Title>
            <Shortcut>test</Shortcut>
            <Description>Inserts a print line.</Description>
            <Author>Nyanmyr</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="CPP">
                <![CDATA[std::cout << "test" << "\n";$end$]]>
            </Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>
