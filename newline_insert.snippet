<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://microsoft.com">
    <CodeSnippet Format="1.0.0">
        <Header>
            <Title>newline_insert</Title>
            <Shortcut>nl</Shortcut>
            <Description>Inserts a new line.</Description>
            <Author>Nyanmyr</Author>
            <SnippetTypes>
                <SnippetType>Expansion</SnippetType>
            </SnippetTypes>
        </Header>
        <Snippet>
            <Code Language="CPP">
                <![CDATA["\n";$end$]]>
            </Code>
        </Snippet>
    </CodeSnippet>
</CodeSnippets>